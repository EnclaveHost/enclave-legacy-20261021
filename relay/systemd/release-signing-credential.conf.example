# Optional enclave-api-relay.service drop-in for attested configuration release.
# Install as zzzz-release-signing-credential.conf. The source stays root:root
# 0600; systemd supplies it to DynamicUser without putting the seed in the env.
# Credentials may have group bits, which the release reader rejects: make an
# owner-only copy inside a private runtime directory instead.
[Service]
LoadCredential=secrets-release-signing.seed:/etc/nan-relay/secrets-release-signing.seed
RuntimeDirectory=enclave-api-relay-secrets
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/install -m 0600 %d/secrets-release-signing.seed /run/enclave-api-relay-secrets/release.seed
# This file must contain only:
# SECRETS_RELEASE_SIGNING_KEY_FILE=/run/enclave-api-relay-secrets/release.seed
# EnvironmentFile overrides Environment; load this after the main env file.
EnvironmentFile=/etc/nan-relay/release-signing-credential.env
